# PostgreSQL Connection
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Business Database (Core API)
BUSINESS_DB_USER=business_db_user
BUSINESS_DB_PASSWORD=business_pass
BUSINESS_DB_NAME=business_db

# Commerce Database (Order API & Payment API)
COMMERCE_DB_USER=commerce_db_user
COMMERCE_DB_PASSWORD=commerce_pass
COMMERCE_DB_NAME=commerce_db

# Security & JWT
JWT_SECRET=super-secret-jwt-key-for-orcamento-app-production-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Inter-service Communication
INTERNAL_API_KEY=internal-secret-service-token-123456

# API Service URLs
CORE_API_URL=http://127.0.0.1:8000
ORDER_API_URL=http://127.0.0.1:8001
PAYMENT_API_URL=http://127.0.0.1:8002
