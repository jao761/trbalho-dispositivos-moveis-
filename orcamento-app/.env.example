# Use the LAN IP of the machine running the APIs, never localhost on a physical device.
EXPO_PUBLIC_CORE_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_ORDER_API_URL=http://192.168.1.10:8001
EXPO_PUBLIC_PAYMENT_API_URL=http://192.168.1.10:8002

# Enable only for the isolated visual prototype. Production/integration must remain false.
EXPO_PUBLIC_USE_MOCKS=false
